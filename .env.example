# Tracking configuration. Copy to .env.local for local testing (it is git-ignored),
# and add the same keys in Netlify > Site configuration > Environment variables for production.
# Leave any value empty to switch that part off.

# ——— Browser (public, bundled into the site) ———
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads tag ID and the conversion label for contact-form leads (optional)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=XXXXXXXXXXXXXXXXXXX
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Server-side tracking runs in production builds by default; set to "true" to test it locally with `netlify dev`
# NEXT_PUBLIC_SERVER_TRACKING=true
# NEXT_PUBLIC_TRACKING_ENDPOINT=/.netlify/functions/track

# ——— Server (secret, used only by netlify/functions/track.mts; never prefix with NEXT_PUBLIC_) ———
# Meta Conversions API
META_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=your-meta-conversions-api-access-token
# From Events Manager > Test events; remove once you've confirmed events arrive
META_TEST_EVENT_CODE=
META_API_VERSION=v23.0
# GA4 Measurement Protocol (GA4 > Admin > Data streams > Measurement Protocol API secrets)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-measurement-protocol-api-secret
# Country code added to local phone numbers before hashing for Meta (880 = Bangladesh)
DEFAULT_PHONE_COUNTRY_CODE=880
# Optional comma-separated list of origins allowed to call the endpoint
TRACKING_ALLOWED_ORIGINS=https://your-site.netlify.app,https://www.your-domain.com
